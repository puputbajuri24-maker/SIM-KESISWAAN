rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bootstrapped Administrator Check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'puputbajuri24@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'waka_kesiswaan'
        ))
      );
    }

    // Guru BK Role Verification
    function isGuruBK() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guru_bk'
        ))
      );
    }

    // Pembina OSIM Role Verification
    function isPembinaOsim() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pembina_osim'
        ))
      );
    }

    // Madrasah Teaching / Coaching Staff Verification
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        isGuruBK() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pembina_ekstrakurikuler' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pembina_osim' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pembina' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pembina_ekskul'
        ))
      );
    }

    // Delegated Cash Manager / Bendahara Verification
    function canManageCash() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCashManager == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.osimPosition == 'bendahara'
        ))
      );
    }

    // 1. User Profiles & RBAC
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isCashManager', 'cashManagerTitle', 'osimPosition', 'osimDepartmentCode']))
      );
      allow delete: if isAdmin();
    }

    // 2. School Settings & Identity
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Academic Calendar & Years
    match /academic_years/{yearId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Classes
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Students Database
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isStaff() || isGuruBK();
      allow delete: if isAdmin();
    }

    // 6. Teachers & Coaches Roster
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. Extracurriculars
    match /extracurriculars/{ekskulId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isStaff() && (resource.data.coachId == request.auth.uid || resource.data.coachName == request.auth.token.name));
      allow delete: if isAdmin();
    }

    // 8. Extracurricular Club Members
    match /extracurricular_members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // 9. Schedules & Calendar
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // 10. Attendance Records
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff();
    }

    // 11. Activities & Agendas
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff() || isSignedIn();
    }

    // 12. Activity Reports (LPJ)
    match /activity_reports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff() || isSignedIn();
    }

    // 13. Violations & Disciplinary Records
    match /violations/{violationId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isGuruBK() || isStaff();
      allow delete: if isAdmin() || isGuruBK();
    }

    // 14. BK Counseling (Strict Confidentiality)
    match /counseling/{counselingId} {
      allow read, write: if isAdmin() || isGuruBK();
    }

    // 15. BK Home Visits
    match /home_visits/{visitId} {
      allow read, write: if isAdmin() || isGuruBK();
    }

    // 16. BK Parent Call Letters
    match /parent_call_letters/{letterId} {
      allow read, write: if isAdmin() || isGuruBK();
    }

    // 17. BK Career Guidance
    match /career_guidances/{careerId} {
      allow read, write: if isAdmin() || isGuruBK();
    }

    // 18. Student Achievements
    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaff() || isGuruBK();
    }

    // 19. Dispensations & Permissions
    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isGuruBK() || isStaff();
    }

    // 20. Needs & Budget Requests
    match /needs_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // 21. OSIM Cabinet Members
    match /osim_members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isPembinaOsim();
    }

    // 22. OSIM Work Programs
    match /osim_programs/{programId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        isPembinaOsim() ||
        (existing().status == 'Draft' || existing().status == 'Revisi' || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lpjDescription', 'lpjAttachments', 'realizedBudget', 'progressPercentage', 'updatedAt']))
      );
      allow delete: if isAdmin() || isPembinaOsim();
    }

    // 23. OSIM Aspirations
    match /osim_aspirations/{aspirationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isPembinaOsim();
    }

    // 24. OSIM Meetings & Minutes
    match /osim_meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isPembinaOsim() || isSignedIn();
    }

    // 25. OSIM Departments
    match /osim_departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isPembinaOsim();
    }

    // 26. Financial Ledger - Cash Accounts
    match /cash_accounts/{accountId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 27. Financial Ledger - Cash Transactions
    match /cash_transactions/{trxId} {
      allow read: if isSignedIn();
      allow create, update: if canManageCash();
      allow delete: if isAdmin();
    }

    // 28. School Rules & Catalog
    match /school_rules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin() || isGuruBK();
    }

    // 29. Madrasah Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 30. Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 31. Notifications
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // 32. Immutable Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Strict Immutability
    }
  }
}
