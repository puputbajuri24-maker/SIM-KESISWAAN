rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET & DEFAULT-DENY CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. CORE PRIMITIVES & IDENTITY HELPERS
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUserRole() {
      return hasUserDoc(request.auth.uid) && ('role' in userDoc(request.auth.uid)) ? userDoc(request.auth.uid).role : '';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'user_super_admin' ||
        (
          'email' in request.auth.token &&
          request.auth.token.email != null &&
          (
            request.auth.token.email.matches('(?i)^puputbajuri24@gmail\\.com$') ||
            request.auth.token.email.matches('(?i)^admin@sekolah\\.sch\\.id$')
          )
        ) ||
        getUserRole() in ['super_admin', 'admin']
      );
    }

    function isWakaKesiswaan() {
      return isSuperAdmin() || (
        isSignedIn() && (
          ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.matches('(?i)^puputbajuri24@gmail\\.com$')) ||
          getUserRole() in ['waka_kesiswaan', 'waka', 'admin_kesiswaan']
        )
      );
    }

    function isWakaOrAdmin() {
      return isWakaKesiswaan();
    }

    function isGuruBk() {
      return isWakaOrAdmin() || (
        isSignedIn() && getUserRole() in ['guru_bk', 'bk']
      );
    }

    function isPembinaOsim() {
      return isWakaOrAdmin() || (
        isSignedIn() && getUserRole() in ['pembina_osim', 'pembina']
      );
    }

    function isPembinaEkskul() {
      return isWakaOrAdmin() || (
        isSignedIn() && getUserRole() in [
          'pembina_ekstrakurikuler', 'pembina_ekskul', 'coach_ekstrakurikuler', 'pembina'
        ]
      );
    }

    function isStaff() {
      return isWakaOrAdmin() || (
        isSignedIn() && getUserRole() in [
          'super_admin', 'admin', 'waka_kesiswaan', 'waka', 'admin_kesiswaan',
          'guru_bk', 'bk', 'pembina_osim', 'pembina',
          'pembina_ekstrakurikuler', 'pembina_ekskul', 'coach_ekstrakurikuler',
          'guru', 'teacher', 'wali_kelas', 'homeroom_teacher'
        ]
      );
    }

    function isCashManager() {
      return isSignedIn() && (
        isWakaOrAdmin() ||
        (hasUserDoc(request.auth.uid) && (
          ('isCashManager' in userDoc(request.auth.uid) && userDoc(request.auth.uid).isCashManager == true) ||
          ('osimPosition' in userDoc(request.auth.uid) && userDoc(request.auth.uid).osimPosition in ['bendahara', 'bendahara_osim'])
        ))
      );
    }

    function isPengurusOsim() {
      return isPembinaOsim() || (
        isSignedIn() && getUserRole() in [
          'anggota_osim', 'pengurus_osim', 'bph_osim', 'ketua_osim', 'wakil_osim',
          'sekretaris_osim', 'bendahara_osim'
        ]
      );
    }

    // =========================================================================
    // 2. VALIDATION BLUEPRINTS (ANTI-UPDATE-GAP)
    // =========================================================================
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.role is string && data.role.size() <= 64;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['id', 'fullName', 'role']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 128 &&
        data.role is string && data.role.size() <= 128;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'nis']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.nis is string && data.nis.size() > 0 && data.nis.size() <= 64;
    }

    function isValidViolation(data) {
      return data.keys().hasAll(['studentId', 'violationType', 'points']) &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
        data.violationType is string && data.violationType.size() > 0 && data.violationType.size() <= 256 &&
        data.points is number;
    }

    function isValidCounseling(data) {
      return data.keys().hasAll(['studentId', 'counselorId']) &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
        data.counselorId is string && data.counselorId.size() > 0 && data.counselorId.size() <= 128;
    }

    function isValidOsimProgram(data) {
      return data.keys().hasAll(['title', 'status']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        data.status is string && data.status.size() <= 64;
    }

    function isValidCashTransaction(data) {
      return data.keys().hasAll(['accountId', 'type', 'amount', 'title']) &&
        data.accountId is string && data.accountId.size() > 0 && data.accountId.size() <= 128 &&
        data.type in ['MASUK', 'KELUAR'] &&
        data.amount is number &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'module', 'details']) &&
        data.action is string && data.action.size() > 0 && data.action.size() <= 128 &&
        data.module is string && data.module.size() > 0 && data.module.size() <= 128 &&
        data.details is string && data.details.size() <= 4096;
    }

    function isValidSnapshot(data) {
      return data.keys().hasAll(['id', 'label', 'timestamp']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.label is string && data.label.size() > 0 && data.label.size() <= 256 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64;
    }

    // =========================================================================
    // 3. USERS COLLECTION (STRICT RBAC & PRIVILEGE ESCALATION PREVENTION)
    // =========================================================================
    match /users/{userId} {
      // Individual users can read their own profile; Staff/Admins can read directory
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isSignedIn() && isStaff();

      // Only Admin can create arbitrary accounts; Self-registration cannot self-assign staff roles or cash manager
      allow create: if isValidId(userId) && isValidUser(incoming()) && (
        isWakaOrAdmin() ||
        (
          isSignedIn() && request.auth.uid == userId &&
          incoming().role in ['anggota_osim', 'siswa', 'student'] &&
          (!('isCashManager' in incoming()) || incoming().isCashManager == false)
        )
      );

      // Updates: Admin has full access. Normal users CANNOT elevate their role, cannot change isCashManager, cannot change UID, and can only edit their own profile
      allow update: if isValidId(userId) && isValidUser(incoming()) && (
        isWakaOrAdmin() ||
        (
          isSignedIn() && request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          (
            (!('isCashManager' in incoming()) && !('isCashManager' in existing())) ||
            incoming().isCashManager == existing().isCashManager
          )
        )
      );

      // Deletions: Only Super Admin can delete users, never delete primary super admin or self
      allow delete: if isValidId(userId) && isSuperAdmin() && userId != 'user_super_admin' && userId != request.auth.uid;
    }

    // =========================================================================
    // 4. TEACHERS & STAFF (CENTRALIZED CPANEL MANAGEMENT)
    // =========================================================================
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isValidId(teacherId) && isWakaOrAdmin() && (request.method == 'delete' || isValidTeacher(incoming()));
    }

    // =========================================================================
    // 5. STUDENTS, CLASSES & ACADEMIC YEARS
    // =========================================================================
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId) && isStaff() && isValidStudent(incoming());
      allow delete: if isValidId(studentId) && isWakaOrAdmin();
    }

    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isValidId(classId) && isWakaOrAdmin();
    }

    match /academic_years/{yearId} {
      allow read: if true;
      allow write: if isValidId(yearId) && isWakaOrAdmin();
    }

    // =========================================================================
    // 6. VIOLATIONS & DISCIPLINARY RULES
    // =========================================================================
    match /violations/{violationId} {
      allow read: if true;
      allow create, update: if isValidId(violationId) && isStaff() && isValidViolation(incoming());
      allow delete: if isValidId(violationId) && isWakaOrAdmin();
    }

    match /school_rules/{ruleId} {
      allow read: if true;
      allow write: if isValidId(ruleId) && isWakaOrAdmin();
    }

    // =========================================================================
    // 7. COUNSELING & DISCIPLINARY ISOLATION (STRICT GURU BK CONFIDENTIALITY)
    // =========================================================================
    match /counseling/{counselingId} {
      allow read: if isGuruBk();
      allow create, update: if isValidId(counselingId) && isGuruBk() && isValidCounseling(incoming());
      allow delete: if isValidId(counselingId) && isGuruBk();
    }

    match /home_visits/{visitId} {
      allow read: if isGuruBk();
      allow write: if isValidId(visitId) && isGuruBk();
    }

    match /parent_call_letters/{letterId} {
      allow read: if isGuruBk();
      allow write: if isValidId(letterId) && isGuruBk();
    }

    match /career_guidances/{guidanceId} {
      allow read: if isGuruBk();
      allow write: if isValidId(guidanceId) && isGuruBk();
    }

    // =========================================================================
    // 8. OSIM WORK PROGRAMS, CABINET & MEETINGS
    // =========================================================================
    match /osim_programs/{programId} {
      allow read: if true;
      allow create: if isValidId(programId) && isPengurusOsim() && isValidOsimProgram(incoming());
      // Status transition to 'Disetujui', 'Selesai & Disahkan', or 'Dibatalkan' requires Pembina OSIM or Waka/Admin veto authority
      // Terminal state lock: once in 'Selesai & Sah', 'Selesai & Disahkan', or 'Dibatalkan', non-supervisors cannot modify
      allow update: if isValidId(programId) && isPengurusOsim() && isValidOsimProgram(incoming()) && (
        isPembinaOsim() ||
        (
          !(existing().status in ['Selesai & Sah', 'Selesai & Disahkan', 'Dibatalkan']) &&
          (
            incoming().status == existing().status ||
            (existing().status in ['Draft', 'Revisi'] && incoming().status == 'Diajukan')
          )
        )
      );
      allow delete: if isValidId(programId) && isPembinaOsim();
    }

    match /osim_members/{memberId} {
      allow read: if true;
      allow write: if isValidId(memberId) && isPengurusOsim();
    }

    match /osim_departments/{departmentId} {
      allow read: if true;
      allow write: if isValidId(departmentId) && (isPembinaOsim() || isWakaOrAdmin());
    }

    match /osim_meetings/{meetingId} {
      allow read: if true;
      allow write: if isValidId(meetingId) && isPengurusOsim();
    }

    match /osim_aspirations/{aspirationId} {
      allow read: if true;
      allow create: if isValidId(aspirationId) && isSignedIn();
      allow update, delete: if isValidId(aspirationId) && isPengurusOsim();
    }

    // =========================================================================
    // 9. EXTRACURRICULARS & MEMBERSHIP
    // =========================================================================
    match /extracurriculars/{clubId} {
      allow read: if true;
      allow create, update: if isValidId(clubId) && isPembinaEkskul();
      // Only Waka or Admin can delete clubs (prevents rogue coach/non-pembina from deleting clubs)
      allow delete: if isValidId(clubId) && isWakaOrAdmin();
    }

    match /extracurricular_members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isValidId(memberId) && isPembinaEkskul();
    }

    // =========================================================================
    // 10. CASH LEDGER & FINANCIAL ACCOUNTS (FINANCIAL SEGREGATION)
    // =========================================================================
    match /cash_accounts/{accountId} {
      allow read: if isSignedIn() && (isCashManager() || isStaff());
      allow write: if isValidId(accountId) && isWakaOrAdmin();
    }

    match /cash_transactions/{transactionId} {
      allow read: if isSignedIn() && (isCashManager() || isStaff());
      allow create: if isValidId(transactionId) && isCashManager() && isValidCashTransaction(incoming());
      allow update: if isValidId(transactionId) && isWakaOrAdmin() && isValidCashTransaction(incoming()) &&
        incoming().accountId == existing().accountId;
      allow delete: if isValidId(transactionId) && isWakaOrAdmin();
    }

    // =========================================================================
    // 11. AUDIT LOGS (IMMUTABLE AUDIT TRAIL)
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isWakaOrAdmin();
      allow create: if isValidId(logId) && isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // =========================================================================
    // 12. INSTITUTIONAL SETTINGS & SCHOOL CONFIG
    // =========================================================================
    match /schools/{schoolId} {
      // Madrasah public branding (logo, name, address) readable by all visitors
      allow read: if true;
      allow write: if isValidId(schoolId) && isWakaOrAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isWakaOrAdmin();
    }

    // =========================================================================
    // 13. SCHEDULES, ATTENDANCE, ACTIVITIES, ANNOUNCEMENTS & PERMISSIONS
    // =========================================================================
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isValidId(scheduleId) && isStaff();
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update, delete: if isValidId(attendanceId) && isStaff();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create, update, delete: if isValidId(activityId) && isStaff();
    }

    match /activity_reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if isValidId(reportId) && isStaff();
    }

    match /needs_requests/{requestId} {
      allow read: if true;
      allow create, update, delete: if isValidId(requestId) && isStaff();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isValidId(announcementId) && isStaff();
    }

    match /permissions/{permissionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(permissionId) && isStaff();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow create, update, delete: if isValidId(achievementId) && isStaff();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notificationId) && isStaff();
    }

    // =========================================================================
    // 14. DISASTER RECOVERY & SYSTEM SNAPSHOTS (FASE 4 FORTRESS STORAGE)
    // =========================================================================
    match /system_snapshots/{snapshotId} {
      allow read, write: if isValidId(snapshotId) && isWakaOrAdmin() && (request.method == 'delete' || isValidSnapshot(incoming()));
    }

    match /test/{testId} {
      // Used by testConnection() healthcheck
      allow read: if true;
    }
  }
}
