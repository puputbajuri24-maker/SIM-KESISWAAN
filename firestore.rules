rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER PRIMITIVES
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // =========================================================================
    // 1. USERS COLLECTION (CENTRALIZED USER PROFILES & AUTH DIRECTORY)
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId) && userId != 'user_super_admin';
    }

    // =========================================================================
    // 2. TEACHERS & STAFF (DEWAN GURU & CPANEL SYNCHRONIZATION)
    // =========================================================================
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update, delete: if isValidId(teacherId);
    }

    // =========================================================================
    // 3. STUDENTS, CLASSES & ACADEMIC YEARS
    // =========================================================================
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isValidId(classId);
    }

    match /academic_years/{yearId} {
      allow read: if true;
      allow write: if isValidId(yearId);
    }

    // =========================================================================
    // 4. VIOLATIONS & DISCIPLINARY RULES
    // =========================================================================
    match /violations/{violationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(violationId);
    }

    match /school_rules/{ruleId} {
      allow read: if true;
      allow write: if isValidId(ruleId);
    }

    // =========================================================================
    // 5. COUNSELING & BK MODULES
    // =========================================================================
    match /counseling/{counselingId} {
      allow read: if true;
      allow write: if isValidId(counselingId);
    }

    match /home_visits/{visitId} {
      allow read: if true;
      allow write: if isValidId(visitId);
    }

    match /parent_call_letters/{letterId} {
      allow read: if true;
      allow write: if isValidId(letterId);
    }

    match /career_guidances/{guidanceId} {
      allow read: if true;
      allow write: if isValidId(guidanceId);
    }

    // =========================================================================
    // 6. OSIM WORK PROGRAMS, CABINET, MEETINGS & ASPIRATIONS
    // =========================================================================
    match /osim_programs/{programId} {
      allow read: if true;
      allow write: if isValidId(programId);
    }

    match /osim_members/{memberId} {
      allow read: if true;
      allow write: if isValidId(memberId);
    }

    match /osim_departments/{departmentId} {
      allow read: if true;
      allow write: if isValidId(departmentId);
    }

    match /osim_meetings/{meetingId} {
      allow read: if true;
      allow write: if isValidId(meetingId);
    }

    match /osim_aspirations/{aspirationId} {
      allow read: if true;
      allow write: if isValidId(aspirationId);
    }

    // =========================================================================
    // 7. EXTRACURRICULARS & MEMBERSHIP
    // =========================================================================
    match /extracurriculars/{clubId} {
      allow read: if true;
      allow write: if isValidId(clubId);
    }

    match /extracurricular_members/{memberId} {
      allow read: if true;
      allow write: if isValidId(memberId);
    }

    // =========================================================================
    // 8. CASH LEDGER & FINANCIAL ACCOUNTS
    // =========================================================================
    match /cash_accounts/{accountId} {
      allow read: if true;
      allow write: if isValidId(accountId);
    }

    match /cash_transactions/{transactionId} {
      allow read: if true;
      allow write: if isValidId(transactionId);
    }

    // =========================================================================
    // 9. AUDIT LOGS (IMMUTABLE AUDIT TRAIL)
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // =========================================================================
    // 10. INSTITUTIONAL SETTINGS & SCHOOL CONFIG
    // =========================================================================
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isValidId(schoolId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // =========================================================================
    // 11. SCHEDULES, ATTENDANCE, ACTIVITIES, ANNOUNCEMENTS & PERMISSIONS
    // =========================================================================
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isValidId(scheduleId);
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if isValidId(attendanceId);
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isValidId(activityId);
    }

    match /activity_reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    match /needs_requests/{requestId} {
      allow read: if true;
      allow write: if isValidId(requestId);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isValidId(announcementId);
    }

    match /permissions/{permissionId} {
      allow read: if true;
      allow write: if isValidId(permissionId);
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isValidId(achievementId);
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    // =========================================================================
    // 12. DISASTER RECOVERY & SYSTEM SNAPSHOTS
    // =========================================================================
    match /system_snapshots/{snapshotId} {
      allow read, write: if isValidId(snapshotId);
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    // Global default-deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
