rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }
    
    function isWakaOrAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'super_admin' ||
        getUserData().role == 'waka_kesiswaan' ||
        getUserData().role == 'admin_kesiswaan'
      );
    }
    
    function isPembina() {
      return isAuthenticated() && getUserData().role == 'pembina';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isWakaOrAdmin() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }
    
    // Schools & Academic Years & Classes
    match /schools/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    match /academic_years/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    match /classes/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    // Teachers & Students
    match /teachers/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    match /students/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    // Extracurriculars
    match /extracurriculars/{id} {
      allow read: if isAuthenticated();
      allow create, delete: if isWakaOrAdmin();
      allow update: if isWakaOrAdmin() || (isPembina() && resource.data.coachId == request.auth.uid);
    }
    
    // Extracurricular Members
    match /extracurricular_members/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Schedules
    match /schedules/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Attendance
    match /attendance/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Activities & Activity Reports
    match /activities/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /activity_reports/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Violations & Counseling (Sensitive, Waka & Admin)
    match /violations/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    match /counseling/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    // Achievements & Permissions
    match /achievements/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /permissions/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Needs Requests
    match /needs_requests/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Announcements & Notifications
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isWakaOrAdmin();
    }
    
    match /notifications/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Audit Logs
    match /audit_logs/{id} {
      allow read: if isWakaOrAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
