{
  "entities": {
    "users": {
      "title": "User Profiles & RBAC",
      "description": "User profiles with canonical roles: super_admin, waka_kesiswaan, guru_bk, coach_ekstrakurikuler, pembina_osim, anggota_osim, siswa",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["super_admin", "waka_kesiswaan", "guru_bk", "coach_ekstrakurikuler", "pembina_osim", "anggota_osim", "siswa", "admin_kesiswaan", "pembina", "pembina_ekskul", "pengurus_osim"] },
        "status": { "type": "string", "enum": ["Aktif", "Nonaktif", "Pending"] },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "nip": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 128 },
        "osimPosition": { "type": "string", "maxLength": 64 },
        "osimDepartmentCode": { "type": "string", "maxLength": 32 },
        "isCashManager": { "type": "boolean" },
        "cashManagerTitle": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "schools": {
      "title": "School Settings",
      "description": "Madrasah identity and institutional metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 256 },
        "address": { "type": "string", "maxLength": 512 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "principalName": { "type": "string", "maxLength": 128 },
        "principalNip": { "type": "string", "maxLength": 64 }
      },
      "required": ["name"]
    },
    "students": {
      "title": "Students Database",
      "description": "Student roster with academic, violation, and achievement points",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "nis": { "type": "string", "maxLength": 64 },
        "nisn": { "type": "string", "maxLength": 64 },
        "className": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "totalViolationPoints": { "type": "number" },
        "totalAchievementPoints": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 }
      },
      "required": ["name", "nis"]
    },
    "violations": {
      "title": "Student Violations",
      "description": "Student disciplinary infractions and sanctions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "violationType": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "enum": ["Ringan", "Sedang", "Berat"] },
        "points": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["studentId", "violationType", "points", "date"]
    },
    "counseling": {
      "title": "Student Counseling Records",
      "description": "Confidential counseling interventions conducted by Guru BK",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "counselorId": { "type": "string", "maxLength": 128 },
        "problemSummary": { "type": "string", "maxLength": 2048 },
        "actionPlan": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "maxLength": 64 },
        "date": { "type": "string" }
      },
      "required": ["studentId", "counselorId", "date"]
    },
    "osim_programs": {
      "title": "OSIM Work Programs",
      "description": "Cabinet work programs, budget planning, LPJ, and supervisory approvals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "sekbid": { "type": "string", "maxLength": 64 },
        "budget": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Diajukan", "Revisi", "Disetujui", "Berlangsung", "Menunggu Verifikasi LPJ", "Selesai & Disahkan", "Dibatalkan"] },
        "progressPercentage": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "status"]
    },
    "cash_transactions": {
      "title": "Cash Ledger Transactions",
      "description": "Debit and credit financial transactions for madrasah student affairs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "accountId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["MASUK", "KELUAR"] },
        "amount": { "type": "number" },
        "title": { "type": "string", "maxLength": 256 },
        "date": { "type": "string" },
        "recordedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["accountId", "type", "amount", "title", "date"]
    },
    "cash_accounts": {
      "title": "Cash Accounts & Pos Dana",
      "description": "Financial ledger accounts and designated managers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "balance": { "type": "number" },
        "initialBalance": { "type": "number" },
        "assignedManagerUserIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "code"]
    },
    "audit_logs": {
      "title": "System Audit Logs",
      "description": "Immutable security and activity audit trails",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "module": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 2048 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "module", "details", "timestamp"]
    },
    "teachers": {
      "title": "Teachers & Staff Roster",
      "description": "Dewan guru and ekstrakurikuler coaches with standardized sequential IDs (guru_01, guru_02...)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "fullName": { "type": "string", "maxLength": 128 },
        "nip": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "role": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" },
        "isCashManager": { "type": "boolean" },
        "cashManagerTitle": { "type": "string", "maxLength": 128 },
        "assignedExtracurriculars": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "fullName", "role"]
    },
    "classes": {
      "title": "School Classes",
      "description": "Madrasah class roster (e.g. X-A, XI-IPA) and designated homeroom teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 64 },
        "grade": { "type": "string", "maxLength": 32 },
        "major": { "type": "string", "maxLength": 64 },
        "homeroomTeacherId": { "type": "string", "maxLength": 64 },
        "homeroomTeacherName": { "type": "string", "maxLength": 128 },
        "studentCount": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "extracurriculars": {
      "title": "Extracurricular Clubs",
      "description": "Extracurricular organizations, club profiles, and pembina assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "coachId": { "type": "string", "maxLength": 64 },
        "coachName": { "type": "string", "maxLength": 128 },
        "memberCount": { "type": "number" },
        "scheduleDay": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "name"]
    },
    "extracurricular_members": {
      "title": "Club Memberships",
      "description": "Student registrations in extracurricular activities",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "extracurricularId": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "studentNis": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["Aktif", "Nonaktif", "Cuti", "Keluar"] }
      },
      "required": ["extracurricularId", "studentId"]
    },
    "system_snapshots": {
      "title": "System Snapshots & Disaster Recovery",
      "description": "Point-in-time state backups for instant rollback and disaster recovery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 256 },
        "timestamp": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "label", "timestamp"]
    }
  },
  "firestore": {
    "/teachers/{teacherId}": {
      "schema": "teachers",
      "description": "Teachers roster with standardized document IDs guru_XX"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and RBAC directory"
    },
    "/schools/{schoolId}": {
      "schema": "schools",
      "description": "School institutional profile and configuration"
    },
    "/students/{studentId}": {
      "schema": "students",
      "description": "Student records and discipline telemetry"
    },
    "/violations/{violationId}": {
      "schema": "violations",
      "description": "Student infractions recorded by BK and discipline officers"
    },
    "/counseling/{counselingId}": {
      "schema": "counseling",
      "description": "Confidential BK counseling documentation"
    },
    "/osim_programs/{programId}": {
      "schema": "osim_programs",
      "description": "OSIM work programs and supervisory workflows"
    },
    "/cash_transactions/{transactionId}": {
      "schema": "cash_transactions",
      "description": "Ledger financial transactions"
    },
    "/cash_accounts/{accountId}": {
      "schema": "cash_accounts",
      "description": "Cash account ledger and balances"
    },
    "/audit_logs/{logId}": {
      "schema": "audit_logs",
      "description": "Immutable system audit trail"
    },
    "/classes/{classId}": {
      "schema": "classes",
      "description": "Academic classes catalog"
    },
    "/extracurriculars/{clubId}": {
      "schema": "extracurriculars",
      "description": "Extracurricular clubs catalog"
    },
    "/extracurricular_members/{memberId}": {
      "schema": "extracurricular_members",
      "description": "Extracurricular club membership registry"
    },
    "/system_snapshots/{snapshotId}": {
      "schema": "system_snapshots",
      "description": "System state point-in-time recovery snapshots"
    }
  }
}
